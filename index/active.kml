ACTIVITIES ANNOUNCED BY REF (B) TURKISH NOTAM A4808/26 HAVE ALREADY
BEEN EXPRESSED IN THE REF (A) GREEK NOTAM A3968/26, WHICH IS THE ONLY
VALID AND EFFECTIVE WITHIN ATHINAI FIR, AND THEY REMAIN UNCHANGED.</description><MultiGeometry><Polygon><outerBoundaryIs><LinearRing><coordinates>24.75,42.76663333333333,0 25.987089892612055,42.68029072961939,0 27.18659143483478,42.423886394799915,0 28.31205837928481,42.00521104484156,0 29.32929398236878,41.43698591839286,0 30.207390055033045,40.736476248385166,0 30.91966609244774,39.92496666666667,0 31.444479947645096,39.02711448123422,0 31.765885417203563,38.07020047640705,0 31.87411675856962,37.0833,0 31.765885417203563,36.09639952359295,0 31.444479947645096,35.13948551876579,0 30.91966609244774,34.24163333333333,0 30.207390055033045,33.430123751614836,0 29.32929398236878,32.729614081607146,0 28.312058379284814,32.16138895515844,0 27.18659143483478,31.742713605200088,0 25.987089892612055,31.48630927038062,0 24.75,31.399966666666668,0 23.51291010738795,31.486309270380616,0 22.31340856516522,31.742713605200088,0 21.18794162071519,32.16138895515844,0 20.17070601763122,32.72961408160714,0 19.292609944966955,33.430123751614836,0 18.58033390755226,34.24163333333333,0 18.055520052354904,35.13948551876579,0 17.734114582796437,36.09639952359295,0 17.62588324143038,37.0833,0 17.734114582796437,38.07020047640705,0 18.055520052354904,39.02711448123422,0 18.580333907552255,39.92496666666666,0 19.292609944966955,40.736476248385166,0 20.170706017631215,41.43698591839286,0 21.187941620715193,42.00521104484156,0 22.313408565165222,42.423886394799915,0 23.512910107387945,42.68029072961939,0 24.75,42.76663333333333,0</coordinates></LinearRing></outerBoundaryIs></Polygon></MultiGeometry></Placemark>
